{
  "name": "gamerdex-auth",
  "version": "1.1.0",
  "private": true,
  "description": "The small Vercel project that swaps sign in codes and refresh tokens for tokens, for the Gamerdex apps. It holds the client secrets.",
  "scripts": {
    "lint": "tsc --noEmit && eslint .",
    "format": "prettier --write \"**/*.ts\" \"**/*.md\" \"**/*.json\"",
    "format:check": "prettier --check \"**/*.ts\" \"**/*.md\" \"**/*.json\"",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "author": "Christopher Pezza",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@gamerdexapp/gamerdex-sync": "0.5.0"
  }
}
