GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=
DROPBOX_CLIENT_SECRET=
MICROSOFT_CLIENT_SECRET=
ALLOWED_ORIGINS=http://localhost:3000
# The client IDs of Google, Dropbox and Microsoft default to the IDs in gamerdex-sync. Set
# GOOGLE_CLIENT_ID, DROPBOX_CLIENT_ID or MICROSOFT_CLIENT_ID only to use another client. A value
# that is set but empty makes that provider answer 500.
